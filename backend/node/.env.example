PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase server credentials. Never expose the service-role key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-sb-secret-key

# Auth.js requires a random secret with at least 32 characters.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GOOGLE_ID=google-oauth-client-id
AUTH_GOOGLE_SECRET=google-oauth-client-secret

# Keep administrator identity in the local environment, never in source code.
ADMIN_EMAIL=admin@your-domain.com
ADMIN_FULL_NAME=Platform Administrator
ADMIN_DEPARTMENT=Management
ADMIN_POSITION=System Administrator
